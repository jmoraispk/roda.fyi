# Public browser configuration. These values are safe to expose, but the real
# project values belong in .env.local and Vercel's environment settings.
RODA_SUPABASE_URL=
RODA_SUPABASE_PUBLISHABLE_KEY=

# Phone notifications: optional VAPID public key (base64url). The production key
# is committed in scripts/build.mjs; its private half is a Supabase function
# secret and never belongs here.
RODA_VAPID_PUBLIC_KEY=
